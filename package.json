{
  "name": "cf-toolkit",
  "version": "0.1.0",
  "private": true,
  "description": "CF Toolkit — Codeforces all-in-one extension (dịch đề, lọc div, dark mode, Nộp bài nhanh...)",
  "type": "module",
  "scripts": {
    "dev": "vite build --watch",
    "build": "tsc --noEmit && vite build",
    "build:content": "vite build -c vite.content.config.ts",
    "build:all": "npm run build && npm run build:content",
    "package": "npm run build:all && node scripts/package.mjs",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "idb": "^8.0.0",
    "webextension-polyfill": "^0.10.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/webextension-polyfill": "^0.12.6",
    "jsdom": "^25.0.1",
    "typescript": "^5.6.3",
    "vite": "^6.0.3",
    "vitest": "^2.1.8"
  }
}